import {
  CloudSyncMutation,
  CloudSyncState,
  CloudRecord,
  CloudTombstone,
} from './types';

import {
  createEmptyCloudSyncState,
  getCloudSyncDeviceId,
  loadCloudSyncState,
  saveCloudSyncState,
} from './storage';

import { emitCloudSyncEvent } from './events';

const compareMetadata = (
  incoming: {
    updatedAt: number;
    deviceId: string;
  },
  existing?: {
    updatedAt: number;
    deviceId: string;
  },
): number => {
  if (!existing) {
    return 1;
  }

  if (incoming.updatedAt !== existing.updatedAt) {
    return incoming.updatedAt > existing.updatedAt ? 1 : -1;
  }

  if (incoming.deviceId === existing.deviceId) {
    return 0;
  }

  return incoming.deviceId < existing.deviceId ? -1 : 1;
};

const getMutationMap = (
  state: CloudSyncState,
  entity: Exclude<CloudSyncMutation['entity'], 'setting'>,
): Record<string, CloudRecord<unknown> | CloudTombstone> => {
  switch (entity) {
    case 'bookmark-category':
      return state.bookmarks.categories;

    case 'bookmark-membership':
      return state.bookmarks.memberships;

    case 'history':
      return state.history;

    case 'player-time':
      return state.playerTime;

    case 'schedule-mark':
      return state.scheduleMarks;

    case 'comment':
      return state.comments;

    default:
      throw new Error(`Unsupported CloudSync entity: ${entity}`);
  }
};

const applyRecord = (
  target: Record<string, CloudRecord<unknown> | CloudTombstone>,
  id: string,
  mutation: CloudSyncMutation,
  updatedAt: number,
  deviceId: string,
): boolean => {
  const existing = target[id];

  if (
    existing &&
    compareMetadata(
      { updatedAt, deviceId },
      existing.meta,
    ) <= 0
  ) {
    return false;
  }

  if (mutation.deleted) {
    target[id] = {
      meta: {
        updatedAt,
        deviceId,
        deleted: true,
      },
    };
  } else {
    target[id] = {
      value: mutation.value,
      meta: {
        updatedAt,
        deviceId,
      },
    };
  }

  return true;
};

export const mutateCloudSync = (
  mutation: CloudSyncMutation,
): CloudSyncMutation => {
  const state = loadCloudSyncState() ?? createEmptyCloudSyncState();

  const updatedAt = mutation.updatedAt ?? Date.now();
  const deviceId = mutation.deviceId ?? getCloudSyncDeviceId();

  const normalizedMutation: CloudSyncMutation = {
    ...mutation,
    updatedAt,
    deviceId,
  };

  let changed = false;

  if (normalizedMutation.entity === 'setting') {
    const existingMetadata =
      state.settings.metadata[normalizedMutation.id];

    if (
      !existingMetadata ||
      compareMetadata(
        { updatedAt, deviceId },
        existingMetadata,
      ) > 0
    ) {
      state.settings.metadata[normalizedMutation.id] = {
        updatedAt,
        deviceId,
        ...(normalizedMutation.deleted ? { deleted: true } : {}),
      };

      if (normalizedMutation.deleted) {
        delete state.settings.values[normalizedMutation.id];
      } else {
        state.settings.values[normalizedMutation.id] =
          normalizedMutation.value;
      }

      changed = true;
    }
  } else {
    changed = applyRecord(
      getMutationMap(state, normalizedMutation.entity),
      normalizedMutation.id,
      normalizedMutation,
      updatedAt,
      deviceId,
    );
  }

  if (changed) {
    state.revision += 1;
    state.updatedAt = Math.max(state.updatedAt, updatedAt);
    state.deviceId = deviceId;

    saveCloudSyncState(state);

    emitCloudSyncEvent({
      type: 'mutation',
      mutation: normalizedMutation,
    });
  }

  return normalizedMutation;
};

